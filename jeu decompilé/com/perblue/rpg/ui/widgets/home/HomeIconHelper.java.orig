	public static HomeIconData getData(HomeIconType type) {
		if(HOME_ICONS.isEmpty() || DEBUG_HOME_SCREEN) {
			createData();
		}
		
		return HOME_ICONS.get(type);
	}
	
	//TODO
	public static void doContestVFX(final HomeIcon icon, RPGSkin skin) {

		if(!icon.getType().equals(HomeIconType.CONTESTS)) {
			return;
		}
		if(isAnimating){
			return;
		}
		else {
			isAnimating = true;
			ParticleEffectContainer flamingSword = new ParticleEffectContainer(ParticleType.ui_main_contests_flamingSword);
			flamingSword.setEffectScale(.82f);
			
			//down beams
			final Image midBeam = new Image(skin.getDrawable(UI.contests.beamRayOne));
			final Image leftBeam = new Image(skin.getDrawable(UI.contests.beamRayTwo));
			final Image rightBeam = new Image(skin.getDrawable(UI.contests.beamRayThree));
			
			leftBeam.setColor(Style.color.vip());
			leftBeam.getColor().a = .5f;
			leftBeam.setY(icon.getHeight());
			leftBeam.setX(-icon.getX()*.4f);
			leftBeam.setScale(1.25f);
			
			rightBeam.setColor(Style.color.vip());
			rightBeam.getColor().a = .5f;
			rightBeam.setY(icon.getHeight());
			rightBeam.setX(icon.getX()*.4f);
			rightBeam.setScale(1.25f);
			
			midBeam.setColor(Style.color.vip());
			midBeam.getColor().a = .65f;
			midBeam.setY(icon.getHeight());
			midBeam.setX(0);
			midBeam.setScale(1.25f);

			icon.addActor(leftBeam);
			leftBeam.getColor().a = 0f;
			icon.addActor(rightBeam);
			rightBeam.getColor().a = 0f;
			icon.addActor(midBeam);
			midBeam.getColor().a = 0f;
			
			final Table swordStack = new Table();
			swordStack.add(flamingSword);
			swordStack.setX(icon.getX()/1.6f);
			swordStack.setY(UIHelper.ph(200));
			
			Tween.to(leftBeam, ActorAccessor.ALPHA, 1f).delay(.5f).target(1f).start(RPG.app.getTweenManager());
			Tween.to(rightBeam, ActorAccessor.ALPHA, 1f).delay(.5f).target(1f).start(RPG.app.getTweenManager());
			Tween.to(midBeam, ActorAccessor.ALPHA, 1f).delay(.5f).target(1f).start(RPG.app.getTweenManager());
			
			icon.addActor(swordStack);
			Tween.to(swordStack, ActorAccessor.Y, 2f).delay(.5f).target(-icon.getY()/2).ease(Cubic.IN).start(RPG.app.getTweenManager());
			
			final Image leftUpBeam = new Image(skin.getDrawable(UI.contests.beamRayDownLeft));
			final Image rightUpBeam = new Image(skin.getDrawable(UI.contests.beamRayDownRight));
			
			//up beams
			leftUpBeam.setColor(Style.color.vip());
			leftUpBeam.setX(icon.getX()*.1f);
			leftUpBeam.setY(icon.getY()/2 + icon.getHeight()/2);
			
			rightUpBeam.setColor(Style.color.vip());
			rightUpBeam.setX(icon.getX()*.35f);
			rightUpBeam.setY(icon.getY()/2 + icon.getHeight()/2);
			
			leftUpBeam.getColor().a = .7f;
			rightUpBeam.getColor().a = .7f;
			
			final ParticleEffectContainer shine = new ParticleEffectContainer(ParticleType.ui_main_contests_hold_Rr);
			shine.setEffectScale(.7f);
			shine.align(Align.center);
			shine.setX(icon.getX()/1.6f);
			shine.setY(icon.getY()/2+icon.getHeight()/1.75f);
			
			final ParticleEffectContainer haze = new ParticleEffectContainer(ParticleType.ui_main_contests_hold_Fr);
			haze.setEffectScale(1f);
			haze.setX(icon.getX()/1.55f);
			haze.setY(icon.getY()/2+icon.getHeight()/2);
			
			final Image glow = new Image(skin.getDrawable(UI.contests.snow), Scaling.fit);
			glow.setColor(Style.color.vip());
			glow.getColor().a = .5f;
			glow.setX(icon.getX()*.1f);
			glow.setY(icon.getY()/2 + icon.getHeight()*.2f);
			
			final ParticleEffectContainer landing = new ParticleEffectContainer(ParticleType.ui_main_contests_sword_shockwave);
			landing.setEffectScale(1f);
			landing.setX(icon.getX()/1.6f);
			landing.setY(icon.getY()/2+icon.getHeight()/2);
			
			//lets animate this sh*t
			Tween.call(new TweenCallback() {
				@Override
				public void onEvent(int type, BaseTween<?> source) {
					swordStack.remove();
					icon.setState(IconState.ENABLED);
					
					icon.addActor(landing);
					
					icon.addActor(shine);
					
					icon.addActor(glow);
					glow.toBack();
					
					icon.addActor(haze);
					
					icon.addActor(leftUpBeam);
					icon.addActor(rightUpBeam);
					
					leftBeam.remove();
					midBeam.remove();
					rightBeam.remove();
					
					ClientActionHelper.setFlag(UserFlag.HAS_SEEN_CONTEST_START, true);
					isAnimating = false;
					
				}
			}).delay(2.5f).start(RPG.app.getTweenManager());
			
			icon.toFront();
			Tween.to(leftUpBeam, ActorAccessor.ALPHA, 2.5f).target(0f).delay(7f).start(RPG.app.getTweenManager());
			Tween.to(rightUpBeam, ActorAccessor.ALPHA, 2.5f).target(0f).delay(7f).start(RPG.app.getTweenManager());
			Tween.to(haze, ActorAccessor.ALPHA, 2.5f).target(0f).delay(7f).start(RPG.app.getTweenManager());
			Tween.to(shine, ActorAccessor.ALPHA, 2.5f).target(0f).delay(7f).start(RPG.app.getTweenManager());
			
			//get rid of animation stuff and set flag as having seen the contest
			Tween.call(new TweenCallback() {
				@Override
				public void onEvent(int type, BaseTween<?> source) {
					leftUpBeam.remove();
					rightUpBeam.remove();
					shine.remove();
					haze.remove();
				}
			}).delay(10f).start(RPG.app.getTweenManager());
		
		}
	}
}
